{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/notepad", "destination": "/tools/notepad", "permanent": true },
    { "source": "/stopwatch", "destination": "/tools/stopwatch", "permanent": true },
    { "source": "/word-counter", "destination": "/tools/word-counter", "permanent": true },
    { "source": "/json-formatter", "destination": "/tools/json-formatter", "permanent": true },
    { "source": "/image-resizer", "destination": "/tools/image-resizer", "permanent": true },
    { "source": "/password-generator", "destination": "/tools/password-generator", "permanent": true },
    { "source": "/base64-encoder", "destination": "/tools/base64-encoder", "permanent": true },
    { "source": "/markdown-previewer", "destination": "/tools/markdown-previewer", "permanent": true },
    { "source": "/uuid-generator", "destination": "/tools/uuid-generator", "permanent": true },
    { "source": "/color-converter", "destination": "/tools/color-converter", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|ads\\.txt|robots\\.txt|sitemap\\.xml|.*\\.html|.*\\.xml|.*\\.txt|.*\\.svg|.*\\.png|.*\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
